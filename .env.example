DATABASE_URL="file:./data/app.db"

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=""

# Secret Telegram sends with every webhook request (set via setWebhook's secret_token)
TELEGRAM_WEBHOOK_SECRET=""

# Your own Telegram id — receives /support messages and usage-monitor alerts/reports.
ADMIN_TG_ID=""

# Self-hosted analytics. SQLite is on by default; file/Telegram stream are opt-in.
# Set ANALYTICS_ENABLED="0" to pause all analytics immediately.
ANALYTICS_ENABLED="1"
ANALYTICS_DB_ENABLED="1"
ANALYTICS_FILE_ENABLED="0"
ANALYTICS_LOG_PATH="./data/analytics-events.jsonl"
ANALYTICS_TELEGRAM_ENABLED="0"

# Link import: Workers AI structures a venue/post, Brave Search fills missing facts.
# Both optional — import just degrades to "couldn't parse" without them.
# LINK_IMPORT_LIMIT unset/empty means unlimited; set a number when imports should be capped.
LINK_IMPORT_LIMIT=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
CLOUDFLARE_AI_MAX_TOKENS="4096"
# The daily Workers AI neuron quota used for usage-monitor threshold alerts/reports.
CLOUDFLARE_AI_DAILY_FREE_NEURONS="10000"
BRAVE_SEARCH_API_KEY=""
