// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model DateIdea {
  id               String            @id @default(cuid())
  telegramUserId   String
  title            String
  description      String?
  swipeDescription String?
  priceNote        String?
  tags             TagsOnDateIdeas[]
  locations        Location[]
  links            PlaceLink[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([telegramUserId])
}

model Location {
  id         String   @id @default(cuid())
  dateIdeaId String
  address    String?
  metro      String?
  lat        Float?
  lng        Float?
  url        String?
  dateIdea   DateIdea @relation(fields: [dateIdeaId], references: [id], onDelete: Cascade)
}

/// A place can carry several free-form links (Instagram, booking, website, the source post)
/// beyond the one map link on its Location -- kept in their own ordered list so a non-map
/// link found while parsing never has to overwrite or get dropped in favor of the map link.
model PlaceLink {
  id         String   @id @default(cuid())
  dateIdeaId String
  label      String?
  url        String
  position   Int
  dateIdea   DateIdea @relation(fields: [dateIdeaId], references: [id], onDelete: Cascade)

  @@unique([dateIdeaId, position])
}

model Tag {
  id    String            @id @default(cuid())
  name  String            @unique
  ideas TagsOnDateIdeas[]
}

model TagsOnDateIdeas {
  dateIdeaId String
  tagId      String
  dateIdea   DateIdea @relation(fields: [dateIdeaId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dateIdeaId, tagId])
}

/// Holds an idea parsed from a shared link while it waits for approval in the
/// Telegram chat (not the Mini App). chatId doubles as the owning user's
/// telegramUserId for private 1:1 bot chats.
model PendingImport {
  id        String   @id @default(cuid())
  chatId    String
  sourceUrl String
  payload   String
  /// Which bot flow produced this draft (bot_yandex_link / bot_channel_forward /
  /// bot_telegram_post_link / bot_pasted_text) -- carried through to the place_created
  /// analytics event on approval.
  source    String   @default("unknown")
  createdAt DateTime @default(now())
}

/// Meters AI-powered link/post imports per Telegram user (a handful free before
/// a paid plan is needed).
model ImportQuota {
  telegramUserId String   @id
  usedCount      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// /support messages from the bot -- kept here as a durable copy in case the
/// Telegram DM to the admin gets missed.
model SupportMessage {
  id             String   @id @default(cuid())
  telegramUserId String
  username       String?
  text           String
  createdAt      DateTime @default(now())
}

/// Minimal self-hosted product analytics -- one row per tracked event. `properties` is a
/// JSON-encoded string (e.g. {"source":"manual"}), queried ad hoc / summarized in the daily
/// usage report rather than through a dedicated dashboard for now.
model AnalyticsEvent {
  id             String   @id @default(cuid())
  name           String
  telegramUserId String?
  properties     String?
  createdAt      DateTime @default(now())

  @@index([name])
  @@index([telegramUserId])
}
