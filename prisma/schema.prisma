// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model DateIdea {
  id               String            @id @default(cuid())
  telegramUserId   String
  title            String
  description      String?
  swipeDescription String?
  priceNote        String?
  tags             TagsOnDateIdeas[]
  locations        Location[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([telegramUserId])
}

model Location {
  id         String   @id @default(cuid())
  dateIdeaId String
  address    String?
  metro      String?
  lat        Float?
  lng        Float?
  url        String?
  dateIdea   DateIdea @relation(fields: [dateIdeaId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String            @id @default(cuid())
  name  String            @unique
  ideas TagsOnDateIdeas[]
}

model TagsOnDateIdeas {
  dateIdeaId String
  tagId      String
  dateIdea   DateIdea @relation(fields: [dateIdeaId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dateIdeaId, tagId])
}

/// Holds an idea parsed from a shared link while it waits for approval in the
/// Telegram chat (not the Mini App). chatId doubles as the owning user's
/// telegramUserId for private 1:1 bot chats.
model PendingImport {
  id        String   @id @default(cuid())
  chatId    String
  sourceUrl String
  payload   String
  createdAt DateTime @default(now())
}

/// Meters AI-powered link/post imports per Telegram user (a handful free before
/// a paid plan is needed).
model ImportQuota {
  telegramUserId String   @id
  usedCount      Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// /support messages from the bot -- kept here as a durable copy in case the
/// Telegram DM to the admin gets missed.
model SupportMessage {
  id             String   @id @default(cuid())
  telegramUserId String
  username       String?
  text           String
  createdAt      DateTime @default(now())
}
